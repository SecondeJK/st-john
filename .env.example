# Copy to .env.development / .env.staging / .env.production and fill in.
# scripts/hugo.sh loads .env, then .env.<environment>. Variables already set in
# the shell or by the hosting platform take precedence over these files.

# Public URL of the site (staging/production). Development uses localhost.
HUGO_BASEURL=https://www.example.org/

# Sanity CMS, for blog posts only (https://www.sanity.io/manage)
HUGO_SANITY_PROJECT_ID=
HUGO_SANITY_DATASET=production
# Optional read token: only needed if the dataset is private.
HUGO_SANITY_TOKEN=

# Google Calendar: a public calendar ID and an API key restricted to the Calendar API.
HUGO_GCAL_ID=
HUGO_GCAL_API_KEY=

# Test site: build from fixtures (test blog posts and events) whatever the environment,
# with noindex. Set on a Netlify test site; see deploy-test-site.md.
# HUGO_TEST_SITE=true

# Optional local overrides, e.g. preview live blog posts in development:
# HUGO_PARAMS_BLOG_SOURCE=sanity
# HUGO_PARAMS_CALENDAR_SOURCE=google
