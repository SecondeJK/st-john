{{- /*
  Every page on the site is generated here. There are deliberately no Markdown files
  under content/: edit pages in data/site.yaml, and blog posts in the CMS
  (data/fixtures/posts.yaml for local test data; see partials/blog/data.html).
*/ -}}
{{- $data := site.Data.site -}}

{{- /* A page with children (e.g. about → about/staff) must be a section. */ -}}
{{- $paths := slice -}}
{{- range $data.pages }}{{ $paths = $paths | append .path }}{{ end -}}

{{- range $data.pages -}}
  {{- $path := .path -}}
  {{- $kind := "page" -}}
  {{- range $paths -}}
    {{- if hasPrefix . (printf "%s/" $path) }}{{ $kind = "section" }}{{ end -}}
  {{- end -}}
  {{- if eq $path "blog" }}{{ $kind = "section" }}{{ end -}}

  {{- $page := dict
    "kind" $kind
    "path" $path
    "title" .title
    "weight" (.weight | default 0)
    "content" (dict "mediaType" "text/markdown" "value" (.body | default ""))
    "params" (dict
      "summary" .summary
      "heroImage" .heroImage
      "gallery" .gallery
    )
  -}}
  {{- with .layout }}{{ $page = merge $page (dict "layout" .) }}{{ end -}}
  {{- $.AddPage $page -}}
{{- end -}}

{{- range partialCached "blog/data.html" "blog" -}}
  {{- $.AddPage (dict
    "kind" "page"
    "path" (printf "blog/%s" .slug)
    "title" .title
    "dates" (dict "date" (time.AsTime .publishedAt))
    "content" (dict "mediaType" "text/markdown" "value" (.body | default ""))
    "params" (dict
      "tags" .tags
      "author" .author
      "excerpt" .excerpt
      "media" .media
    )
  ) -}}
{{- end -}}
